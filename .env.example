# Copy to .env (start.bat does this). Never commit .env.
# Detector: auto = YOLO26 if Ultralytics is installed, otherwise the bundled NanoDet (fast) / YOLOX (accurate),
# chosen per camera on the Setup page. Other values: yolo, yolox, nanodet, off (video only).
TRINETRA_DETECTOR=auto
YOLO_WEIGHTS=yolo26n.pt
YOLO_IMGSZ=640
# YOLO_DEVICE=0
# Upper limit on analysed frames per second for every camera (each camera also has its own limit)
ANALYSIS_FPS=15
TRINETRA_PORT=8000
# Camera 4 (uploaded video): largest upload in MB, and where uploaded videos are kept
TRINETRA_MAX_UPLOAD_MB=1024
# TRINETRA_UPLOADS=uploads
# OPERATOR_TOKEN=change-me
FRONTEND_ORIGIN=http://localhost:5173
